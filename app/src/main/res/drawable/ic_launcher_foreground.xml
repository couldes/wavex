<?xml version="1.0" encoding="utf-8"?>
<!-- 自适应图标前景：白色对话气泡（含尾巴）+ 蓝靛→青渐变单峰大波
     几何已缩放进 108 视口安全区（内容最远点半径 ≈34 < 36，圆形遮罩不裁切）；
     波形渐变沿 x36→72 横向过渡，与背景层渐变同色系 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 气泡主体：x29.52-78.48, y35.28-72.72, rx12.24 -->
    <path
        android:pathData="M41.76,35.28 H66.24 A12.24,12.24 0 0 1 78.48,47.52 V60.48 A12.24,12.24 0 0 1 66.24,72.72 H41.76 A12.24,12.24 0 0 1 29.52,60.48 V47.52 A12.24,12.24 0 0 1 41.76,35.28 Z"
        android:fillColor="#FFFFFFFF" />
    <!-- 气泡尾巴（与主体同色叠放，顶部没入气泡底边形成整体） -->
    <path
        android:pathData="M37.92,71.28 L37.92,83.68 L50.88,71.28 Z"
        android:fillColor="#FFFFFFFF" />
    <!-- 单峰大波：蓝靛→青横向渐变描边 -->
    <path
        android:pathData="M36,54 C41.98,39.82 49.3,39.82 54,54 C58.7,68.18 66.02,68.18 72,54"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="36"
                android:startY="54"
                android:endX="72"
                android:endY="54">
                <item
                    android:color="#FF1D4ED8"
                    android:offset="0.0" />
                <item
                    android:color="#FF06B6D4"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
