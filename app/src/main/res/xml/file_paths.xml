<?xml version="1.0" encoding="utf-8"?>
<!-- FileProvider 共享路径：拍照临时文件（files/camera/）交给系统相机写入 -->
<paths>
    <files-path
        name="camera"
        path="camera/" />
    <!-- 模型返回文件落盘目录（files/generated/）：ACTION_VIEW 打开时共享给外部应用 -->
    <files-path
        name="generated"
        path="generated/" />
</paths>
