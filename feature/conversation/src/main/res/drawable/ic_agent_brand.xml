<?xml version="1.0" encoding="utf-8"?>
<!-- 应用内品牌图标（抽屉栏等）：白色对话气泡（含尾巴）+ 蓝靛→青渐变单峰大波
     与启动器/闪屏图标（ic_launcher_foreground / ic_agent_splash）构图同构，
     但几何放大 1.5 倍铺满画布——应用内自绘圆形底无系统遮罩，无需安全区留白 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 气泡主体：x17.28-90.72, y25.92-82.08, rx18.36 -->
    <path
        android:pathData="M35.64,25.92 H72.36 A18.36,18.36 0 0 1 90.72,44.28 V63.72 A18.36,18.36 0 0 1 72.36,82.08 H35.64 A18.36,18.36 0 0 1 17.28,63.72 V44.28 A18.36,18.36 0 0 1 35.64,25.92 Z"
        android:fillColor="#FFFFFFFF" />
    <!-- 气泡尾巴（与主体同色叠放，顶部没入气泡底边形成整体） -->
    <path
        android:pathData="M29.88,79.92 L29.88,98.52 L49.32,79.92 Z"
        android:fillColor="#FFFFFFFF" />
    <!-- 单峰大波：蓝靛→青横向渐变描边 -->
    <path
        android:pathData="M27,54 C35.97,32.73 46.95,32.73 54,54 C61.05,75.27 72.03,75.27 81,54"
        android:strokeWidth="7.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="27"
                android:startY="54"
                android:endX="81"
                android:endY="54">
                <item
                    android:color="#FF1D4ED8"
                    android:offset="0.0" />
                <item
                    android:color="#FF06B6D4"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
